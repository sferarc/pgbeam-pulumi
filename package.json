{
  "name": "@pgbeam/pulumi",
  "version": "0.6.1",
  "description": "Pulumi provider for PgBeam, a Postgres proxy for safe AI agent access: manage projects, databases, agent credentials and policy profiles as infrastructure",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ai-agents",
    "mcp",
    "database-security",
    "pgbeam",
    "pulumi",
    "infrastructure-as-code",
    "postgresql",
    "iac"
  ],
  "homepage": "https://pgbeam.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sferarc/pgbeam-pulumi.git"
  },
  "bugs": {
    "url": "https://github.com/sferarc/pgbeam-pulumi/issues"
  },
  "scripts": {
    "build": "bunchee",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "pgbeam": "^0.10.1"
  },
  "peerDependencies": {
    "@pulumi/pulumi": "catalog:peers"
  },
  "devDependencies": {
    "@pulumi/pulumi": "catalog:peers",
    "typescript": "catalog:pulumi"
  }
}
